{
  "$schema": "cards-game/v1",
  "id": "euchre",
  "name": "Euchre",
  "version": "1.0",
  "deck": "euchre-24",
  "players": { "min": 3, "max": 4 },
  "teams": false,
  "rounds": {
    "repeat_until": "win_condition",
    "dealer": "rotates_left"
  },
  "deal": {
    "cards_per_player": 5,
    "face": "owner",
    "remainder_to": "kitty",
    "then_flip_top_of": "kitty"
  },
  "zones": [
    { "id": "deck",       "type": "deck",   "visibility": "none" },
    { "id": "hand",       "type": "hand",   "owner": "each_player", "visibility": "owner", "layout": { "region": "seat" } },
    { "id": "kitty",      "type": "pile",   "visibility": "top" },
    { "id": "trick",      "type": "trick",  "owner": "each_player", "visibility": "all",
      "layout": { "place": { "x": "50%", "y": "70%", "anchor": "center", "width": "12%", "height": "12%" } } },
    { "id": "won_tricks", "type": "pile",   "owner": "each_team",   "visibility": "count_only",
      "layout": { "place": { "x": "94%", "y": "93%", "anchor": "center", "width": "8%", "height": "8%" } } }
  ],
  "phases": [
    {
      "id": "order_up",
      "type": "bidding",
      "style": "accept_or_pass",
      "once_around": true,
      "if_accepted": {
        "sets": { "trump": "turned_card_suit", "maker": "accepting_player" },
        "dealer_action": "swap_turned_card",
        "next": "play"
      },
      "if_all_pass": "call_trump"
    },
    {
      "id": "call_trump",
      "type": "bidding",
      "style": "suit_or_pass",
      "exclude_suit": "turned_card_suit",
      "stick_the_dealer": true,
      "going_alone": true,
      "once_around": true,
      "if_called": {
        "sets": { "trump": "bidder_choice", "maker": "calling_player" },
        "next": "play"
      }
    },
    {
      "id": "dealer_discard",
      "type": "dealer_discard",
      "next": "play"
    },
    {
      "id": "play",
      "type": "trick_taking",
      "trump": "bid_result",
      "lead": "left_of_dealer",
      "direction": "clockwise",
      "follow_suit": true,
      "left_bower": true,
      "winner": "highest_trump_then_lead",
      "trick_winner_leads_next": true,
      "collect_tricks_to": "won_tricks",
      "loner_skips_partner": true,
      "next": "score"
    },
    {
      "id": "score",
      "type": "score"
    }
  ],
  "scoring": {
    "type": "euchre",
    "makers_win": { "tricks_3_or_4": 1, "tricks_5": 2 },
    "euchred": { "opponents_score": 2 },
    "loner_win": { "tricks_5": 4 },
    "count_by": "team",
    "accumulate": true
  },
  "configurations": [
    {
      "when": { "players": 3 },
      "teams": false,
      "deal": {
        "anim_deal_steps": [[0,3],[1,2],[2,3],[0,2],[1,3],[2,2]]
      },
      "scoring": {
        "type": "euchre",
        "makers_win": { "tricks_3_to_5": 1 },
        "euchred": { "opponents_each_score": 2 },
        "loner_win": null,
        "count_by": "player",
        "accumulate": true
      },
      "overrides": {
        "play.loner_skips_partner": false
      }
    },
    {
      "when": { "players": 4 },
      "teams": {
        "count": 2,
        "size": 2,
        "arrangement": "alternating"
      },
      "deal": {
        "anim_deal_steps": [[0,3],[1,2],[2,3],[3,2],[0,2],[1,3],[2,2],[3,3]]
      }
    }
  ],
  "ui": {
    "default_sort": "suit_value",
    "sort_modes": ["suit_value", "suit_stable", "rank_ace_high"]
  },
  "win_condition": { "type": "target_score", "score": 10, "winner": "first" },
  "house_rules": [
    {
      "id": "no_stick_dealer",
      "name": "No Stick the Dealer",
      "description": "Dealer may pass in the second round of bidding (no forced call).",
      "default": false,
      "affects": { "call_trump.stick_the_dealer": false }
    },
    {
      "id": "no_loner",
      "name": "No Going Alone",
      "description": "Players cannot go alone.",
      "default": false,
      "affects": { "call_trump.going_alone": false }
    },
    {
      "id": "farmers_hand",
      "name": "Farmer's Hand",
      "description": "A player dealt three nines (or three nines and a ten) may throw in their hand and force a redeal.",
      "default": false
    }
  ],
  "help": "euchre.md"
}

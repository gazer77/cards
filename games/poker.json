{
  "$schema": "cards-game/v1",
  "id": "poker",
  "name": "Poker",
  "version": "1.0",
  "deck": "standard-52",
  "players": { "min": 2, "max": 9, "starting_score": 1000 },
  "teams": false,
  "rounds": {
    "repeat_until": "win_condition",
    "dealer": "rotates_left"
  },
  "blinds": {
    "small": { "position": "left_of_dealer",       "amount": 1 },
    "big":   { "position": "two_left_of_dealer",   "amount": 2 }
  },
  "zones": [
    { "id": "deck",      "type": "deck",   "visibility": "none",
      "layout": { "region": "center-left" } },
    { "id": "hand",      "type": "hand",   "owner": "each_player", "visibility": "owner", "layout": { "region": "seat" } },
    { "id": "community", "type": "spread", "visibility": "all",
      "layout": { "region": "center" } },
    { "id": "burn",      "type": "pile",   "visibility": "none",
      "layout": { "region": "center-left" } },
    { "id": "pot",       "type": "pot",    "visibility": "all",
      "layout": { "region": "center-right" } }
  ],
  "phases": [
    {
      "id": "deal_hole",
      "type": "deal",
      "to": "each_player",
      "count": 2,
      "face": "owner",
      "next": "bet_preflop"
    },
    {
      "id": "bet_preflop",
      "type": "poker_betting",
      "structure": "no_limit",
      "post_blinds": true,
      "starting_player": "three_left_of_dealer",
      "can_check": false,
      "next": "flop"
    },
    {
      "id": "flop",
      "type": "deal",
      "burn_first": true,
      "to": "community",
      "count": 3,
      "face": "up",
      "next": "bet_flop"
    },
    {
      "id": "bet_flop",
      "type": "poker_betting",
      "structure": "no_limit",
      "starting_player": "left_of_dealer",
      "can_check": true,
      "next": "turn"
    },
    {
      "id": "turn",
      "type": "deal",
      "burn_first": true,
      "to": "community",
      "count": 1,
      "face": "up",
      "next": "bet_turn"
    },
    {
      "id": "bet_turn",
      "type": "poker_betting",
      "structure": "no_limit",
      "starting_player": "left_of_dealer",
      "can_check": true,
      "next": "river"
    },
    {
      "id": "river",
      "type": "deal",
      "burn_first": true,
      "to": "community",
      "count": 1,
      "face": "up",
      "next": "bet_river"
    },
    {
      "id": "bet_river",
      "type": "poker_betting",
      "structure": "no_limit",
      "starting_player": "left_of_dealer",
      "can_check": true,
      "next": "showdown"
    },
    {
      "id": "showdown",
      "type": "showdown",
      "evaluator": "high_hand",
      "community_zone": "community",
      "hand_size": 5,
      "use_from_hand": { "min": 0, "max": 2 }
    }
  ],
  "scoring": {
    "type": "hand_rank",
    "evaluator": "high_hand",
    "wilds": []
  },
  "win_condition": { "type": "last_with_chips" },
  "house_rules": [
    {
      "id": "limit",
      "name": "Limit Betting",
      "description": "Fixed betting limits instead of no-limit.",
      "default": false,
      "affects": {
        "bet_preflop.structure": "limit",
        "bet_flop.structure": "limit",
        "bet_turn.structure": "limit",
        "bet_river.structure": "limit"
      }
    }
  ],
  "configurations": [
    {
      "name": "Texas Hold'em",
      "description": "Two cards down, five shared. Blinds, and bet what you like.",
      "default": true
    },
    {
      "name": "Deuces Wild",
      "description": "Hold'em, with every two standing for whatever you need.",
      "help": "poker-wilds.md",
      "scoring": {
        "type": "hand_rank",
        "evaluator": "high_hand",
        "wilds": [{ "rank": "2" }]
      },
      "house_rules": [
        {
          "id": "limit",
          "name": "Limit Betting",
          "description": "Fixed betting limits instead of no-limit.",
          "default": false,
          "affects": {
            "bet_preflop.structure": "limit",
            "bet_flop.structure": "limit",
            "bet_turn.structure": "limit",
            "bet_river.structure": "limit"
          }
        },
        {
          "id": "one_eyed_jacks",
          "name": "One-Eyed Jacks Wild",
          "description": "Add Jh and Js as additional wild cards.",
          "default": false,
          "affects": {
            "scoring.wilds": { "append": [{ "card": "Jh" }, { "card": "Js" }] }
          }
        }
      ]
    },
    {
      "name": "Seven-Card Stud",
      "description": "Seven cards each, four of them showing. An ante, and fixed limits.",
      "help": "poker-stud.md",
      "when": { "max_players": 8 },
      "players": { "min": 2, "max": 8, "starting_score": 1000 },
      "blinds": null,
      "ante": { "amount": 1 },
      "zones": [
        { "id": "deck",  "type": "deck",   "visibility": "none" },
        { "id": "hand",  "type": "hand",   "owner": "each_player", "visibility": "mixed", "layout": { "region": "seat" } },
        { "id": "burn",  "type": "pile",   "visibility": "none" },
        { "id": "pot",   "type": "pot",    "visibility": "all" }
      ],
      "phases": [
        {
          "id": "deal_third_street",
          "type": "deal",
          "to": "each_player",
          "cards": [
            { "count": 2, "face": "owner" },
            { "count": 1, "face": "up" }
          ],
          "next": "bet_third"
        },
        {
          "id": "bet_third",
          "type": "poker_betting",
          "structure": "limit",
          "starting_player": "lowest_up_card",
          "bring_in": true,
          "can_check": false,
          "next": "deal_fourth"
        },
        {
          "id": "deal_fourth",
          "type": "deal",
          "to": "each_active_player",
          "count": 1,
          "face": "up",
          "next": "bet_fourth"
        },
        {
          "id": "bet_fourth",
          "type": "poker_betting",
          "structure": "limit",
          "starting_player": "highest_up_cards",
          "can_check": false,
          "next": "deal_fifth"
        },
        {
          "id": "deal_fifth",
          "type": "deal",
          "to": "each_active_player",
          "count": 1,
          "face": "up",
          "next": "bet_fifth"
        },
        {
          "id": "bet_fifth",
          "type": "poker_betting",
          "structure": "limit",
          "starting_player": "highest_up_cards",
          "can_check": false,
          "next": "deal_sixth"
        },
        {
          "id": "deal_sixth",
          "type": "deal",
          "to": "each_active_player",
          "count": 1,
          "face": "up",
          "next": "bet_sixth"
        },
        {
          "id": "bet_sixth",
          "type": "poker_betting",
          "structure": "limit",
          "starting_player": "highest_up_cards",
          "can_check": false,
          "next": "deal_seventh"
        },
        {
          "id": "deal_seventh",
          "type": "deal",
          "to": "each_active_player",
          "count": 1,
          "face": "down",
          "next": "bet_seventh"
        },
        {
          "id": "bet_seventh",
          "type": "poker_betting",
          "structure": "limit",
          "starting_player": "highest_up_cards",
          "can_check": false,
          "next": "showdown"
        },
        {
          "id": "showdown",
          "type": "showdown",
          "evaluator": "high_hand",
          "hand_size": 5,
          "use_from_hand": { "min": 5, "max": 7 }
        }
      ],
      "house_rules": [
        {
          "id": "razz",
          "name": "Razz (Low Hand Wins)",
          "description": "Lowest hand wins. Aces are always low. Straights and flushes don't count against you.",
          "default": false,
          "affects": { "scoring.evaluator": "ace_to_five_low" }
        }
      ]
    }
  ],
  "help": "texas-holdem.md",
  "tags": ["poker"]
}

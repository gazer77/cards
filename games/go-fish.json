{
  "$schema": "cards-game/v1",
  "id": "go-fish",
  "name": "Go Fish",
  "version": "1.0",
  "deck": "standard-52",
  "players": { "min": 2, "max": 2, "names": ["You", "AI"] },
  "teams": false,
  "dealer": "random",
  "deal": {
    "cards_per_player": [
      { "max_players": 3, "cards": 7 },
      { "cards": 5 }
    ],
    "remainder_to": "deck",
    "face": "owner"
  },
  "zones": [
    { "id": "deck",  "type": "deck",   "visibility": "none" },
    { "id": "hand",  "type": "hand",   "owner": "each_player", "visibility": "owner" },
    { "id": "books", "type": "spread", "owner": "each_player", "visibility": "all" }
  ],
  "phases": [
    {
      "id": "play",
      "type": "go_fish",
      "book_size": 4,
      "collect_to": "books",
      "next": {
        "if": "win_condition",
        "then": "end",
        "else": "play"
      }
    }
  ],
  "scoring": { "type": "none" },
  "win_condition": { "type": "most_books" },
  "house_rules": [
    {
      "id": "seven_cards_all",
      "name": "7 Cards for All",
      "description": "Deal 7 cards each regardless of player count.",
      "default": false,
      "affects": { "deal.cards_per_player": 7 }
    },
    {
      "id": "pairs",
      "name": "Pairs Instead of Books",
      "description": "Collect pairs of 2 matching cards instead of books of 4.",
      "default": false,
      "affects": { "play.book_size": 2 }
    }
  ],
  "ui": {
    "auto_sort_hand": "rank",
    "allow_sort": true,
    "show_game_log": true
  },
  "help": "go-fish.md"
}

{
  "$schema": "cards-game/v1",
  "id": "whist",
  "name": "Whist",
  "version": "1.0",
  "deck": "standard-52",
  "players": { "min": 4, "max": 4 },
  "teams": {
    "count": 2,
    "size": 2,
    "arrangement": "alternating"
  },
  "rounds": {
    "repeat_until": "win_condition",
    "dealer": "rotates_left",
    "first_dealer": "low_card"
  },
  "deal": {
    "cards_per_player": 13,
    "face": "owner"
  },
  "zones": [
    { "id": "deck",       "type": "deck",  "visibility": "none" },
    { "id": "hand",       "type": "hand",  "owner": "each_player", "visibility": "owner", "layout": { "region": "seat" } },
    { "id": "trick",      "type": "trick", "owner": "each_player", "visibility": "all",
      "layout": { "place": { "x": "50%", "y": "70%", "anchor": "center", "width": "12%", "height": "12%" } } },
    { "id": "won_tricks", "type": "pile",  "owner": "each_team",   "visibility": "count_only",
      "layout": { "place": { "x": "94%", "y": "93%", "anchor": "center", "width": "8%", "height": "8%" } } }
  ],
  "phases": [
    {
      "id": "play",
      "type": "trick_taking",
      "trump": "last_dealt",
      "direction": "clockwise",
      "follow_suit": true,
      "winner": "highest_trump_then_lead",
      "trick_winner_leads_next": true,
      "collect_tricks_to": "won_tricks",
      "next": "score"
    },
    {
      "id": "score",
      "type": "score"
    }
  ],
  "scoring": {
    "type": "tricks_over_book",
    "book": 6,
    "count_by": "team",
    "accumulate": true
  },
  "ui": {
    "default_sort": "suit_value",
    "sort_modes": ["suit_value", "suit_stable", "rank_ace_high"]
  },
  "win_condition": { "type": "target_score", "score": 7, "winner": "first" },
  "house_rules": [
    {
      "id": "short_whist",
      "name": "Short Whist",
      "description": "Play to 5 points instead of 7.",
      "default": false,
      "affects": { "win_condition.score": 5 }
    }
  ],
  "help": "whist.md"
}

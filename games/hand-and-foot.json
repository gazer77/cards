{
  "$schema": "cards-game/v1",
  "id": "hand-and-foot",
  "name": "Hand and Foot",
  "version": "1.0",
  "deck": {
    "ranks": "2-A",
    "copies": "players + 1",
    "jokers": "(players + 1) * 2"
  },
  "players": { "min": 2, "max": 6 },
  "teams": {
    "count": 2,
    "size": 2,
    "arrangement": "alternating",
    "only_when_players": [4, 6]
  },
  "dealer": "random",
  "rounds": {
    "repeat_until": "win_condition",
    "dealer": "rotates_left"
  },
  "deal": {
    "stacks_per_player": 2,
    "cards_per_stack": 13,
    "face": "owner",
    "remainder_to": "deck",
    "then_flip_top_to": "discard"
  },
  "zones": [
    { "id": "deck",      "type": "deck",   "visibility": "none", "card_scale": 0.75,
      "layout": { "region": "center" },
      "label":  { "text": "DECK", "placement": "bottom" },
      "group_badges": [
        { "shows": "cards", "color": "#000000", "text_color": "#FFFFFF",
          "place": { "x": "0%", "y": "100%", "anchor": "center" } }
      ] },
    { "id": "discard",   "type": "pile",   "visibility": "top", "card_scale": 0.75,
      "layout": { "region": "center" },
      "label":  { "text": "DISCARD", "placement": "bottom" } },
    { "id": "hand",      "type": "hand",   "owner": "each_player", "visibility": "owner",
      "layout": { "place": { "x": "50%", "y": "93%", "anchor": "center", "width": "80%", "height": "12%" } },
      "on_receive": [
        { "card": { "rank": "3", "color": "red" }, "move_to": "meld", "replace_from": "deck" }
      ] },
    { "id": "foot",      "type": "hand",   "owner": "each_player", "visibility": "none", "locked_until": "hand_empty",
      "arrangement": "stack", "card_scale": 0.6,
      "layout": { "place": { "x": "5%", "y": "93%", "anchor": "center", "width": "8%", "height": "12%" } },
      "label":  { "text": "" } },
    { "id": "meld",      "type": "spread", "owner": "each_team",   "visibility": "all",
      "card_scale":   1.4,
      "layout":       { "place": { "x": "50%", "y": "75%", "anchor": "center", "width": "88%", "height": "20%" } },
      "arrangement":  "stack",
      "group_layout": "slots",
      "slots": [
        { "match": { "rank": "3", "color": "red" }, "label": "3" },
        { "match": { "rank": "4" },  "label": "4" },
        { "match": { "rank": "5" },  "label": "5" },
        { "match": { "rank": "6" },  "label": "6" },
        { "match": { "rank": "7" },  "label": "7" },
        { "match": { "rank": "8" },  "label": "8" },
        { "match": { "rank": "9" },  "label": "9" },
        { "match": { "rank": "10" }, "label": "10" },
        { "match": { "rank": "J" },  "label": "J" },
        { "match": { "rank": "Q" },  "label": "Q" },
        { "match": { "rank": "K" },  "label": "K" },
        { "match": { "rank": "A" },  "label": "A" },
        { "match": { "wild": true }, "label": "W" }
      ],
      "label":        { "text": "{owner}", "placement": "bottom" },
      "group_badges": [
        { "shows": "loose", "color": "#A5D66F", "text_color": "#1B4D1B", "zero": "–" },
        { "shows": "books", "color": "#F28C28", "text_color": "#FFFFFF" }
      ] }
  ],
  "phases": [
    {
      "id": "play",
      "type": "draw_discard",
      "draw_from": [
        { "zone": "deck" },
        {
          "zone": "discard",
          "requires": {
            "all": [
              "top_discard_is_meldable",
              { "hand_count_of_rank": "top_discard", "at_least": 2 },
              { "any": [ "team_has_melded", "can_open_with_top_discard" ] }
            ]
          },
          "then_must": "meld_top_card"
        }
      ],
      "draw_count": { "from_deck": 2, "from_discard": 7 },
      "discard_count": 1,
      "target_zone": "hand",
      "special_actions": ["meld", "add_to_meld", "go_out"],
      "unmeldable_ranks": ["3"],
      "initial_meld_requirement": [
        { "round": 1, "points": 50 },
        { "round": 2, "points": 90 },
        { "round": 3, "points": 120 },
        { "points": 150 }
      ],
      "go_out_condition": {
        "all": [
          { "books_at_least": 1, "kind": "natural" },
          { "books_at_least": 1, "kind": "wild" }
        ]
      },
      "round_ends_when": "stock_exhausted",
      "next": "score"
    },
    {
      "id": "score",
      "type": "score"
    }
  ],
  "scoring": {
    "type": "meld_points",
    "meld_types": "canasta",
    "card_values": {
      "joker": 50, "2": 20, "A": 20,
      "8": 10, "9": 10, "10": 10, "J": 10, "Q": 10, "K": 10,
      "4": 5, "5": 5, "6": 5, "7": 5,
      "default": 5
    },
    "wild_cards": ["joker", "2"],
    "red_three_penalty": -500,
    "book_size": 7,
    "bonus_cards": [ { "card": { "rank": "3", "color": "red" }, "in": "meld", "points": 100 } ],
    "natural_canasta_bonus": 500,
    "wild_canasta_bonus": 1000,
    "go_out_bonus": 100,
    "accumulate": true,
    "count_by": "team"
  },
  "win_condition": { "type": "target_score", "score": 10000, "winner": "first" },
  "text": {
    "actions": {
      "draw_from_deck":    "Draw Two",
      "draw_from_discard": "Take the Pile",
      "meld":              "Lay Books",
      "add_to_meld":       "Add to Book",
      "go_out":            "Go Out",
      "discard":           "Discard",
      "clear_selection":   "Clear"
    },
    "messages": {
      "turn_draw_you":     "Your turn — draw two, or take the pile",
      "turn_draw":         "{player} to draw",
      "turn_discard_you":  "Your turn — meld, then discard",
      "turn_discard":      "{player} to discard",
      "turn_owed_you":     "Meld the {card} you took from the pile",
      "turn_owed":         "{player} must meld the {card}",
      "foot_picked_up_you":"Into your foot!",
      "foot_picked_up":    "{player} is into their foot",
      "rank_unmeldable":   "{rank}s are never melded — they are for discarding.",
      "opening_too_low_you":"You need {required} to open this round; that is {offered}.",
      "melds_laid":        "{count} books started!",
      "meld_laid":         "Book started!",
      "added_to_meld":     "Added to the book.",
      "card_filed":        "{player}: red 3 set aside"
    }
  },
  "house_rules": [
    {
      "id": "no_teams_4p",
      "name": "No Teams (Cutthroat)",
      "description": "Each player scores individually, even with 4 or 6 players.",
      "default": false,
      "affects": { "teams": false }
    }
  ],
  "help": "hand-and-foot.md"
}

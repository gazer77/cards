{
  "$schema": "cards-game/v1",
  "id": "cribbage",
  "name": "Cribbage",
  "version": "1.0",
  "deck": "standard-52",
  "players": { "min": 2, "max": 3 },
  "rounds": {
    "repeat_until": "win_condition",
    "dealer": "rotates_left",
    "first_dealer": "low_card"
  },
  "deal": {
    "cards_per_player": [ { "max_players": 2, "cards": 6 }, { "cards": 5 } ],
    "face": "owner"
  },
  "zones": [
    { "id": "deck",    "type": "deck",   "visibility": "none",
      "layout": { "region": "center" } },
    { "id": "starter", "type": "pile",   "visibility": "all",
      "layout": { "region": "center" },
      "label": { "text": "Starter", "placement": "bottom" } },
    { "id": "crib",    "type": "pile",   "visibility": "all", "arrangement": "compact",
      "layout": { "region": "center-left",
                  "portrait": { "place": { "x": "18%", "y": "50%", "anchor": "center", "width": "24%", "height": "13%" } } },
      "label": { "text": "Crib", "placement": "bottom" } },
    { "id": "hand",    "type": "hand",   "owner": "each_player", "visibility": "owner",
      "layout": { "region": "seat" } },
    { "id": "played",  "type": "spread", "owner": "each_player", "visibility": "all", "arrangement": "compact",
      "layout": { "region": "seat-front" },
      "label": { "text": "" } }
  ],
  "phases": [
    { "id": "discard", "type": "crib_discard", "keep": 4, "to": "crib", "crib_size": 4, "next": "cut" },
    { "id": "cut",     "type": "cut", "to": "starter", "points": { "his_heels": 2 }, "next": "play" },
    {
      "id": "play",
      "type": "pegging",
      "limit": 31,
      "played": "played",
      "points": {
        "fifteen": 2, "thirty_one": 2, "pair": 2, "pair_royal": 6, "double_pair_royal": 12,
        "run_card": 1, "go": 1, "last_card": 1
      },
      "next": "show"
    },
    {
      "id": "show",
      "type": "show",
      "played": "played",
      "crib": "crib",
      "starter": "starter",
      "points": { "fifteen": 2, "pair": 2, "run_card": 1, "flush_card": 1, "nobs": 1 }
    }
  ],
  "scoring": { "type": "none" },
  "win_condition": { "type": "target_score", "score": 121, "winner": "first" },
  "score_card": {
    "label": "Pegs",
    "view": "total",
    "by": "player",
    "round_label": "D",
    "max_rounds": 8,
    "place": { "x": "1%", "y": "1%", "anchor": "top-left", "width": "12%", "height": "13%" }
  },
  "ui": {
    "default_sort": "rank",
    "sort_modes": ["rank", "suit_value", "rank_ace_high"]
  },
  "configurations": [
    { "when": { "players": 3 },
      "score_card": { "place": { "x": "50%", "y": "1%", "anchor": "top", "width": "14%", "height": "13%" } } }
  ],
  "house_rules": [
    {
      "id": "short_game",
      "name": "Sixty-One",
      "description": "Play to 61 — once round the board — instead of 121.",
      "default": false,
      "affects": { "win_condition.score": 61 }
    }
  ],
  "help": "cribbage.md"
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cards.Web</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- REQUIRED for SkiaSharp. The native Skia library has to be relinked into the
         WebAssembly runtime; without this the app boots and the engine runs, but the
         first paint throws "TypeInitialization_Type, SkiaSharp.SKImageInfo" because
         libSkiaSharp was never linked in.

         This needs the wasm-tools workload:  dotnet workload install wasm-tools
         On this machine workloads are Visual-Studio-managed, so that command must be
         run from an ELEVATED prompt. Without elevation it reports success and
         installs nothing. -->
    <WasmBuildNative>true</WasmBuildNative>

    <!-- The app has no localisation; dropping ICU saves several MB of payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <!-- Pinned to the same SkiaSharp the MAUI head uses, so the shared renderer
         cannot be compiled against two different Skia versions. -->
    <PackageReference Include="SkiaSharp.Views.Blazor" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cards.Core\Cards.Core.csproj" />
    <ProjectReference Include="..\Cards.Rendering\Cards.Rendering.csproj" />
    <ProjectReference Include="..\Cards.App\Cards.App.csproj" />
  </ItemGroup>

</Project>

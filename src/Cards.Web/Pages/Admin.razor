@page "/admin"
@inject Cards.Web.Platform.AccountSync Account
@inject NavigationManager Nav
@inject Cards.Engine.GameLoader Loader

@*
    Looking after this server. A manager sees the open tables — closes one, takes someone
    off one, bans them from every table — and the banned. The admin also sees the people:
    who has which role, a new code for someone who lost theirs, an account removed for good.
    Every change is checked again by the server against the caller's own role; this page
    only offers what it would allow.
*@

<PageTitle>Manage</PageTitle>

<div class="setup">
    <button class="link" @onclick="@(() => Nav.NavigateTo("/settings"))">&larr; Settings</button>

    @if (!Account.IsManager)
    {
        <h1>Manage</h1>
        <p class="muted">Only this server's managers and admin can look after its tables.</p>
    }
    else
    {
        <h1>Tables</h1>
        @if (_rooms is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (_rooms.Count == 0)
        {
            <p class="muted">No tables are open.</p>
        }
        else
        {
            @foreach (var r in _rooms)
            {
                var room = r;
                <section class="setup-block person">
                    <h2>@room.GameName · @room.Code</h2>
                    <p class="muted">
                        @(room.Started ? "Playing" : "Waiting to deal") · last move @room.LastActivity.ToLocalTime().ToString("HH:mm")
                    </p>
                    @foreach (var s in room.Seats.Where(s => s.Name is not null && !s.IsComputer))
                    {
                        var seat = s;
                        <div class="seat-line">
                            <span>@seat.Name@(seat.IsConnected ? "" : " (away)")</span>
                            <button class="choice" @onclick="() => Remove(room, seat, ban: false)">Take off</button>
                            @if (seat.AccountId is not null)
                            {
                                <button class="choice" @onclick="() => Remove(room, seat, ban: true)">Take off and ban</button>
                            }
                        </div>
                    }
                    <div class="choices">
                        @if (_confirmClose == room.Code)
                        {
                            <button class="choice" @onclick="() => Close(room)">Yes — close it</button>
                            <button class="choice" @onclick="() => _confirmClose = null">Leave it open</button>
                        }
                        else
                        {
                            <button class="choice" @onclick="() => _confirmClose = room.Code">Close table…</button>
                        }
                    </div>
                    @if (_roomErrors.TryGetValue(room.Code, out var why))
                    {
                        <p class="error">@why</p>
                    }
                </section>
            }
        }

        <h1>Games</h1>
        <p class="muted">A game turned off is left off the home page and cannot be opened as a table here.</p>
        @if (_allGames is not null)
        {
            @foreach (var g in _allGames)
            {
                var game = g;
                <label class="rule">
                    <input type="checkbox" checked="@(!_gamesOff.Contains(game.Id))"
                           @onchange="e => SetOffered(game.Id, e.Value is true)" />
                    <span><span class="rule-name">@game.Name</span></span>
                </label>
            }
        }

        <h1>Banned</h1>
        @if (_bans is { Count: > 0 })
        {
            @foreach (var b in _bans)
            {
                var banned = b;
                <div class="seat-line">
                    <span>@(banned.Name ?? "No name") · since @banned.Updated.ToLocalTime().ToString("d MMM")</span>
                    <button class="choice" @onclick="() => Unban(banned)">Let back</button>
                </div>
            }
        }
        else
        {
            <p class="muted">Nobody is banned.</p>
        }
    }

    @if (Account.IsAdmin)
    {
        <h1>People</h1>
        <section class="setup-block">
            <h2>Usernames and passwords</h2>
            <p class="muted">
                Whether people may add a username and password to their account and sign in with
                them. Off, everyone carries their six-word code; names already set are kept and
                work again when this is turned back on.
            </p>
            <div class="choices">
                <button class="choice @(Account.UsernamesOffered ? "chosen" : "")" @onclick="() => SetUsernamesOffered(true)">Offered</button>
                <button class="choice @(Account.UsernamesOffered ? "" : "chosen")" @onclick="() => SetUsernamesOffered(false)">Not offered</button>
            </div>
        </section>
    }

    @if (Account.IsAdmin && _accounts is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (Account.IsAdmin && _accounts is not null)
    {
        <p class="muted">
            @_accounts.Count @(_accounts.Count == 1 ? "account" : "accounts"). Each is known by the
            name its player uses at the table; nobody's code is ever shown here.
        </p>

        @foreach (var a in _accounts)
        {
            var account = a;
            <section class="setup-block person">
                <h2>@(account.Name ?? "No name yet")</h2>
                @if (account.Username is { } username)
                {
                    <p class="muted">Signs in as <strong>@username</strong></p>
                }
                <p class="muted">
                    Since @account.Created.ToLocalTime().ToString("d MMM yyyy") · last saved
                    @account.Updated.ToLocalTime().ToString("d MMM, HH:mm") ·
                    @account.SavedGames saved @(account.SavedGames == 1 ? "game" : "games")
                </p>
                <div class="choices">
                    @foreach (var role in Cards.Services.AccountRoles.All)
                    {
                        var captured = role;
                        <button class="choice @(account.Role == captured ? "chosen" : "")"
                                @onclick="() => SetRole(account, captured)">@RoleName(captured)</button>
                    }
                </div>
                <div class="choices">
                    <button class="choice" @onclick="() => NewCode(account)">New code</button>
                    @if (account.Username is not null)
                    {
                        <button class="choice" @onclick="() => ClearLogin(account)">Clear username and password</button>
                    }
                    @if (_confirmDelete == account.Id)
                    {
                        <button class="choice" @onclick="() => Delete(account)">Yes — delete for good</button>
                        <button class="choice" @onclick="() => _confirmDelete = null">Keep</button>
                    }
                    else
                    {
                        <button class="choice" @onclick="() => _confirmDelete = account.Id">Delete…</button>
                    }
                </div>
                @if (_newCodes.TryGetValue(account.Id, out var issued))
                {
                    <p class="account-code">@issued</p>
                    <p class="muted">Give them this code; their old one has stopped working. It is shown once.</p>
                }
                @if (_errors.TryGetValue(account.Id, out var error))
                {
                    <p class="error">@error</p>
                }
            </section>
        }
    }
</div>

@code {
    private List<Cards.Services.AccountSummary>? _accounts;
    private readonly Dictionary<string, string> _newCodes = [];
    private readonly Dictionary<string, string> _errors = [];
    private string? _confirmDelete;

    private List<Cards.Models.GameDefinition>? _allGames;
    private HashSet<string> _gamesOff = [];

    private async Task SetOffered(string gameId, bool offered)
    {
        if (!await Account.SetOfferedAsync(gameId, offered)) return;
        if (offered) _gamesOff.Remove(gameId); else _gamesOff.Add(gameId);
    }

    private List<Cards.Services.RoomSummary>? _rooms;
    private List<Cards.Services.AccountSummary>? _bans;
    private readonly Dictionary<string, string> _roomErrors = [];
    private string? _confirmClose;

    protected override async Task OnInitializedAsync()
    {
        if (Account.IsManager)
        {
            _rooms    = await Account.RoomsAsync();
            _bans     = await Account.BansAsync();
            _gamesOff = await Account.GamesOffAsync();
            _allGames = (await Loader.LoadAllAsync()).OrderBy(g => g.Name).ToList();
        }
        if (Account.IsAdmin) _accounts = await Account.AccountsAsync();
    }

    private async Task Close(Cards.Services.RoomSummary room)
    {
        _confirmClose = null;
        if (await Account.CloseRoomAsync(room.Code)) _rooms?.Remove(room);
        else _roomErrors[room.Code] = "That table has already closed.";
    }

    private async Task Remove(Cards.Services.RoomSummary room, Cards.Services.SeatSummary seat, bool ban)
    {
        _roomErrors.Remove(room.Code);
        if (await Account.RemoveSeatAsync(room.Code, seat.Id, ban) is { } refused)
        {
            _roomErrors[room.Code] = refused;
            return;
        }
        _rooms = await Account.RoomsAsync();
        if (ban) _bans = await Account.BansAsync();
    }

    private async Task Unban(Cards.Services.AccountSummary banned)
    {
        if (await Account.UnbanAsync(banned.Id)) _bans?.Remove(banned);
    }

    private static string RoleName(string role) => role switch
    {
        Cards.Services.AccountRoles.Admin   => "Admin",
        Cards.Services.AccountRoles.Manager => "Manager",
        _                                   => "Player",
    };

    private async Task SetRole(Cards.Services.AccountSummary account, string role)
    {
        _errors.Remove(account.Id);
        if (await Account.SetRoleAsync(account.Id, role) is { } refused) _errors[account.Id] = refused;
        else account.Role = role;
    }

    private async Task NewCode(Cards.Services.AccountSummary account)
    {
        _errors.Remove(account.Id);
        if (await Account.NewCodeForAsync(account.Id) is { } code) _newCodes[account.Id] = code;
        else _errors[account.Id] = "Could not make a new code.";
    }

    private async Task SetUsernamesOffered(bool offered) => await Account.SetUsernamesOfferedAsync(offered);

    /// <summary>A person who forgot their password: clear it, and they add a new one with their code.</summary>
    private async Task ClearLogin(Cards.Services.AccountSummary account)
    {
        _errors.Remove(account.Id);
        if (await Account.ClearLoginForAsync(account.Id)) account.Username = null;
        else _errors[account.Id] = "Could not clear it.";
    }

    private async Task Delete(Cards.Services.AccountSummary account)
    {
        _confirmDelete = null;
        if (await Account.DeleteAccountAsync(account.Id) is { } refused) _errors[account.Id] = refused;
        else _accounts?.Remove(account);
    }
}

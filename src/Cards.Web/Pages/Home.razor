@page "/"
@inject GameLoader Loader
@inject NavigationManager Nav

<PageTitle>Cards</PageTitle>

<div class="picker">
    <h1>Cards</h1>
    <p class="tagline">Pick a game.</p>

    @if (_games is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in _games)
            {
                <button class="game-card" @onclick="() => Play(game)">
                    <span class="game-name">@game.Name</span>
                    <span class="game-players">@game.PlayerRangeText</span>
                </button>
            }
        </div>
    }
</div>

@code {
    private List<Cards.Models.GameDefinition>? _games;

    protected override async Task OnInitializedAsync()
        => _games = await Loader.LoadAllAsync();

    private void Play(Cards.Models.GameDefinition game)
        => Nav.NavigateTo($"/play/{game.Id}/{DefaultSeats(game)}");

    /// <summary>
    /// Seats to open with. Most games are best at their minimum for a first look,
    /// but a two-seat minimum on a partnership game gives a misleading table, so
    /// four is preferred where the game allows it.
    /// </summary>
    private static int DefaultSeats(Cards.Models.GameDefinition game)
        => game.MinPlayers <= 4 && game.MaxPlayers >= 4 ? 4 : game.MinPlayers;
}

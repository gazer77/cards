@page "/play/{GameId}/{Seats:int}"
@inject GameTableViewModel Vm
@inject NavigationManager Nav
@inject Cards.Services.SettingsService Settings
@inject Cards.Services.HelpService Help
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_title)</PageTitle>

<div class="table-page">
    <header class="table-bar">
        <button class="link" @onclick="GoHome">&larr; Games</button>
        <span class="table-title">@_title</span>
        <button class="link @(_diagnostics ? "on" : "")"
                title="Frame timings"
                @onclick="ToggleDiagnostics">fps</button>
        <button class="link gear" title="Menu" @onclick="() => _menu = !_menu">&#9881;</button>
    </header>

    @if (_menu)
    {
        @* Click-catcher: tapping anywhere off the menu closes it. *@
        <div class="scrim" @onclick="() => _menu = false"></div>
        <nav class="menu">
            @if (Vm.CanSortHand)
            {
                <div class="menu-heading">Sort hand</div>
                @foreach (var (mode, label) in _sortModes)
                {
                    var captured = mode;
                    <button class="menu-item indent @(_sort == captured ? "chosen" : "")"
                            @onclick="() => SortHand(captured)">@label</button>
                }
                <hr />
            }
            @* Options: what the table looks like, as opposed to what the game does.
               Sizes nest one level further so the section stays readable â the same
               shape, and the same tick, as the sort above. *@
            <div class="menu-heading">Options</div>
            @foreach (var (target, label) in SizeTargets)
            {
                var capturedTarget = target;
                <button class="menu-item indent submenu @(_sizeMenu == capturedTarget ? "open" : "")"
                        @onclick="() => _sizeMenu = _sizeMenu == capturedTarget ? null : capturedTarget">
                    <span>@(_sizeMenu == capturedTarget ? "▾" : "▸") @label size</span>
                    <span class="menu-note">@SizeLabelFor(capturedTarget)</span>
                </button>
                @if (_sizeMenu == capturedTarget)
                {
                    @foreach (var (sizeId, sizeLabel, _) in Cards.Services.UiSizes.All)
                    {
                        var capturedSize = sizeId;
                        <button class="menu-item indent-2 @(SizeOf(capturedTarget) == capturedSize ? "chosen" : "")"
                                @onclick="() => SetSize(capturedTarget, capturedSize)">@sizeLabel</button>
                    }
                }
            }
            <button class="menu-item indent @(_showCardValues ? "chosen" : "")"
                    @onclick="ToggleCardValues">Show card points</button>
            <hr />
            <button class="menu-item" @onclick="ShowLog">Game log</button>
            <button class="menu-item" @onclick="ShowRules">Rules</button>
            <button class="menu-item" @onclick="ConfirmNewGame">New game</button>
            <button class="menu-item" @onclick="ConfirmLeave">Leave game</button>
        </nav>
    }

    @if (_overlay is not null)
    {
        <div class="scrim" @onclick="() => _overlay = null"></div>
        <section class="overlay">
            <h2>@_overlayTitle</h2>
            <div class="overlay-body">
                @if (_overlayLines is not null)
                {
                    @foreach (var line in _overlayLines)
                    {
                        <p class="log-line">@line</p>
                    }
                }
                else
                {
                    <pre class="rules">@_overlay</pre>
                }
            </div>
            <div class="overlay-buttons">
                @if (_overlayLines is not null)
                {
                    <span class="export-note">@_exportNote</span>
                    <button class="action" @onclick="CopyReport">Copy report</button>
                    <button class="action" @onclick="DownloadReport">Save file</button>
                }
                <button class="action" @onclick="() => _overlay = null">Close</button>
            </div>
        </section>
    }

    @if (Vm.IsGameOver && !_gameOverDismissed)
    {
        <div class="scrim"></div>
        <section class="overlay game-over">
            <h2>@Vm.StatusText</h2>

            @if (Vm.GameOverDetail.Length > 0)
            {
                <p class="muted">@Vm.GameOverDetail</p>
            }

            @if (Vm.FinalScores.Count > 0)
            {
                <div class="standings">
                    @foreach (var row in Vm.FinalScores)
                    {
                        <div class="standing @(row.IsWinner ? "winner" : "")">
                            <span>@row.Name</span>
                            <span>@row.Score</span>
                        </div>
                    }
                </div>
            }

            <div class="confirm-buttons">
                @* Staying on the table lets the player read the final position, which
                   is most of the point in a game decided by what everyone was holding. *@
                <button class="action" @onclick="() => _gameOverDismissed = true">View table</button>
                <button class="action" @onclick="GoHome">Games</button>
                <button class="action primary" @onclick="NewGame">Play again</button>
            </div>
        </section>
    }

    @if (_confirm is not null)
    {
        <div class="scrim"></div>
        <section class="overlay confirm">
            <h2>@_confirmTitle</h2>
            <p>@_confirmMessage</p>
            <div class="confirm-buttons">
                <button class="action" @onclick="() => _confirm = null">Cancel</button>
                <button class="action primary" @onclick="RunConfirmed">@_confirmVerb</button>
            </div>
        </section>
    }

    @if (_failed)
    {
        <p class="error">Could not load &ldquo;@GameId&rdquo;.</p>
    }
    else
    {
        <GameTableCanvas @ref="_canvas"
                         CardTapped="OnCardTapped"
                         ZoneTapped="OnZoneTapped"
                         ZoneActivated="OnZoneActivated"
                         CardActivated="OnCardActivated"
                         TableTapped="OnTableTapped"
                         CardDropped="OnCardDropped"
                         CardReordered="OnCardReordered" />

        <div class="status" style="font-size: @StatusFontSize">@Vm.StatusText</div>

        <div class="action-bar">
            @if (Vm.ShowActionButtons)
            {
                @foreach (var action in Vm.Actions)
                {
                    var captured = action;
                    <button class="@(action.Type == "ready" ? "action primary" : "action")"
                            @onclick="() => Vm.Invoke(captured)">
                        @(action.Label ?? action.Type)
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string GameId { get; set; } = string.Empty;
    [Parameter] public int Seats { get; set; }

    /// <summary>Comma-separated house rule ids, as chosen on the setup page.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "rules")]
    public string? Rules { get; set; }

    /// <summary>Save slot to resume, when arriving from the resume list.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "slot")]
    public string? Slot { get; set; }

    private GameTableCanvas? _canvas;
    private bool _failed;
    private bool _diagnostics;

    /// <summary>
    /// Set when the player dismisses the game-over screen to look at the final table.
    /// Cleared on a new game, so the next result is announced.
    /// </summary>
    private bool _gameOverDismissed;
    private string _title = "";

    private IReadOnlyList<string> EnabledRules =>
        string.IsNullOrWhiteSpace(Rules)
            ? []
            : Rules.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override void OnInitialized()
    {
        Vm.Changed       += OnVmChanged;
        Vm.MessagePosted += OnMessagePosted;
    }

    private void OnMessagePosted(string playerId, string text)
    {
        // The log always records the line; the bubble is what the setting governs.
        if (Settings.ShowGameMessages)
            _canvas?.Renderer?.PostMessage(playerId, text);
    }

    private void OnVmChanged()
    {
        // Push to the canvas synchronously. The turn loop applies an action, raises
        // this, and then immediately asks the animator to fly the moved cards â so the
        // renderer must already hold the new state when that happens. Deferring the
        // push meant fly-ins were queued against the previous position.
        PushToCanvas();

        // The surrounding Blazor markup (status line, action buttons) is not on a
        // render path here, so that part does have to be marshalled.
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The game cannot start until the canvas exists. Dealing is choreographed
        // against the table's real geometry â where the deck sits, where each hand
        // fans out â so starting from OnInitializedAsync meant the entire opening
        // deal, and every AI turn before the player's first, played out against no
        // table at all and was over before anything was ever drawn.
        if (_canvas?.Renderer is not null)
        {
            Vm.Animator = new RendererTableAnimator(_canvas.Renderer);

            _diagnostics = Settings.ShowDiagnostics;
            _canvas.Renderer.ShowDiagnostics = _diagnostics;
            _canvas.Renderer.SetSkin(SkinFactory.Create(Settings.CardSkinId));

            // Debug:RevealAllCards turns every hand face-up. Configuration only, with
            // no way to reach it from the UI: it is for finding bugs about which cards
            // are where, and it destroys the game for anyone who enables it by mistake.
            // Only appsettings.Development.json sets it, so a published build cannot.
            _canvas.Renderer.RevealAllCards =
                Config.GetValue<bool>("Debug:RevealAllCards");

            ApplyDisplaySettings();
        }

        // Pace comes from the player now. The engine's own timing was tuned against a
        // phone, where a turn also costs a touch and a glance; watching AI seats needs
        // longer, and how much longer is a matter of taste.
        Vm.TurnPace         = Settings.TurnPace;
        Vm.MinimumTurnPause = TimeSpan.FromMilliseconds(650);

        PushToCanvas();

        // The sort travels WITH the start, so the deal flies cards straight to their
        // sorted slots. Sorting afterwards dealt in shuffle order and then snapped the
        // hand into place â the table visibly rearranging itself the moment it settled.
        _sort = Settings.GetHandSort(GameId) ?? Settings.DefaultHandSort;

        _failed = !await Vm.StartAsync(GameId, Seats, EnabledRules, resume: Slot is not null,
                                       resumeSlotId: Slot, initialSort: _sort);
        _title      = Vm.State?.Definition.Name ?? GameId;
        _sortModes  = Vm.SortModes;
        _sort       = Vm.ActiveSortMode;   // reflects the definition's default if we passed none
        StateHasChanged();
    }

    private void PushToCanvas()
        => _canvas?.Sync(Vm.State, Vm.SelectableCardIds, Vm.SelectedCardId, Vm.DropZoneIds,
                         Vm.SelectedMeldGroups);

    private Task OnCardTapped((string CardId, int Uid) card) => Vm.TapCard(card.CardId, card.Uid);
    private Task OnZoneTapped(string zoneId)   => Vm.TapZone(zoneId);
    private Task OnZoneActivated(string zoneId)=> Vm.ActivateZone(zoneId);
    private Task OnCardActivated((string CardId, int Uid) card) => Vm.ActivateCard(card.CardId, card.Uid);
    private Task OnTableTapped()               => Vm.TapTable();
    private Task OnCardDropped((string CardId, string ZoneId) e) => Vm.DropCard(e.CardId, e.ZoneId);

    private void OnCardReordered((string CardId, int NewIndex) e)
        => Vm.ReorderInHand(e.CardId, e.NewIndex);

    // ââ Gear menu âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

    private bool _menu;
    private IReadOnlyList<(string Mode, string Label)> _sortModes = [];
    private string? _sort;

    private string? _overlay;
    private string  _overlayTitle = "";
    private IReadOnlyList<string>? _overlayLines;

    private Func<Task>? _confirm;
    private string _confirmTitle   = "";
    private string _confirmMessage = "";
    private string _confirmVerb    = "";

    // ââ Options âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

    /// <summary>"All" first, then each element on its own â a player usually wants one
    /// dial, and occasionally wants to say "small cards, large text".</summary>
    private static readonly (string Target, string Label)[] SizeTargets =
        [("all", "All"), .. Cards.Services.UiSizes.Targets];

    /// <summary>Which size list is open, or null. One at a time keeps the menu short.</summary>
    private string? _sizeMenu;
    private bool    _showCardValues;

    private string? SizeOf(string target)
        => target == "all" ? Settings.CommonUiSize : Settings.GetUiSize(target);

    private string SizeLabelFor(string target)
        => SizeOf(target) is { } id ? Cards.Services.UiSizes.LabelOf(id) : "Mixed";

    private void SetSize(string target, string sizeId)
    {
        if (target == "all") Settings.SetAllUiSizes(sizeId);
        else                 Settings.SetUiSize(target, sizeId);

        _sizeMenu = null;
        ApplyDisplaySettings();
    }

    private void ToggleCardValues()
    {
        _showCardValues = !_showCardValues;
        Settings.ShowCardValues = _showCardValues;
        ApplyDisplaySettings();
    }

    /// <summary>The status line's own size, as a CSS length, from the chosen step.</summary>
    private string StatusFontSize
        => (1.0 * Settings.UiScale("status")).ToString("0.###",
               System.Globalization.CultureInfo.InvariantCulture) + "rem";

    /// <summary>
    /// Pushes the player's display choices into the renderer and repaints. Called on
    /// load and whenever one changes, so a size takes effect where it was chosen
    /// rather than on the next deal.
    /// </summary>
    private void ApplyDisplaySettings()
    {
        _showCardValues = Settings.ShowCardValues;
        if (_canvas?.Renderer is not { } renderer) return;

        renderer.CardScale     = (float)Settings.UiScale("cards");
        renderer.BubbleScale   = (float)Settings.UiScale("bubbles");
        renderer.TooltipScale  = (float)Settings.UiScale("tooltip");
        renderer.ShowCardValues = _showCardValues;
        _canvas.Redraw();
    }

    private void SortHand(string mode)
    {
        _menu = false;
        _sort = mode;
        Settings.SetHandSort(GameId, mode);

        // Sorting also stays in effect, so cards won later land in place. "Free" is a
        // real choice â it stops the sorting rather than doing nothing.
        Vm.SortHand(mode);
    }


    private void ShowLog()
    {
        _menu         = false;
        _overlayTitle = "Game log";
        _overlayLines = Vm.GameLog.Count > 0 ? Vm.GameLog : ["Nothing has happened yet."];
        _overlay      = "";
        _exportNote   = "";
    }

    // ââ Export ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

    private string _exportNote = "";

    /// <summary>
    /// The full report: state, every card and where it is, metadata and the log.
    ///
    /// The log alone is only half a card-game bug; the other half is where the cards
    /// actually are, which is what the game hides and what cannot be counted reliably
    /// from a screenshot.
    /// </summary>
    private string BuildReport()
        => GameReport.Build(Vm, Seats, EnabledRules,
                            _canvas?.Renderer?.Diagnostics.CardCensus);

    private async Task CopyReport()
    {
        try
        {
            var module = await ExportModule();
            bool ok = await module.InvokeAsync<bool>("copy", BuildReport());

            // The clipboard can be refused for reasons the page cannot see, so say
            // which happened rather than looking like nothing occurred.
            _exportNote = ok ? "Copied." : "Copy blocked â use Save file.";
        }
        catch
        {
            _exportNote = "Copy failed â use Save file.";
        }
    }

    private async Task DownloadReport()
    {
        try
        {
            var module = await ExportModule();
            await module.InvokeVoidAsync("download", GameReport.FileName(Vm), BuildReport());
            _exportNote = "Saved.";
        }
        catch
        {
            _exportNote = "Save failed.";
        }
    }

    private IJSObjectReference? _export;

    private async Task<IJSObjectReference> ExportModule()
        => _export ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/export.js");

    private async Task ShowRules()
    {
        _menu         = false;
        _overlayTitle = "Rules";
        _overlayLines = null;
        _overlay      = "Loadingâ¦";
        StateHasChanged();

        _overlay = await Help.LoadAsync(GameId);
    }

    private void ConfirmNewGame()
    {
        _menu           = false;
        _confirmTitle   = "New game";
        _confirmMessage = "Start a new game? Your current progress will be lost.";
        _confirmVerb    = "New game";
        _confirm        = NewGame;
    }

    private void ConfirmLeave()
    {
        _menu = false;

        // A finished game has nothing left to lose, so leaving it needs no warning.
        if (Vm.IsGameOver) { LeaveGame(); return; }

        _confirmTitle   = "Leave game";
        _confirmMessage = "Leave this game? Your progress is saved and you can resume it later.";
        _confirmVerb    = "Leave";
        _confirm        = () => { LeaveGame(); return Task.CompletedTask; };
    }

    private async Task RunConfirmed()
    {
        var action = _confirm;
        _confirm = null;
        if (action is not null) await action();
    }

    private void LeaveGame() => _ = GoHome();

    private void ToggleDiagnostics()
    {
        _diagnostics = !_diagnostics;
        Settings.ShowDiagnostics = _diagnostics;

        if (_canvas?.Renderer is not null)
        {
            _canvas.Renderer.ShowDiagnostics = _diagnostics;
            _canvas.Redraw();
        }
    }

    private async Task NewGame()
    {
        _gameOverDismissed = false;
        await Vm.DeleteSaveAsync();
        _canvas?.Renderer?.ClearMessages();   // last game's bubbles are not this game's
        await Vm.StartAsync(GameId, Seats, EnabledRules, resume: false, initialSort: _sort);
    }

    private async Task GoHome()
    {
        // A finished game has nothing worth resuming, and saving it would leave a dead
        // row in the resume list that the player has to clear themselves.
        if (!Vm.IsGameOver) await Vm.SaveAsync();
        else                await Vm.DeleteSaveAsync();

        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Vm.Changed       -= OnVmChanged;
        Vm.MessagePosted -= OnMessagePosted;
    }
}

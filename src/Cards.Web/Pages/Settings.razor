@page "/settings"
@inject Cards.Services.SettingsService Prefs
@inject NavigationManager Nav
@inject Cards.Web.Platform.AccountSync Account
@inject IJSRuntime JS

@*
    Somewhere to change the things the app already knew how to do.

    Turn pace, hand sort and game messages were all live settings with no way to reach
    them — the pace in particular was a constant chosen in the page, with a comment
    admitting it was provisional.
*@

<PageTitle>Settings</PageTitle>

<div class="setup">
    <button class="link" @onclick="@(() => Nav.NavigateTo("/"))">&larr; Games</button>

    <h1>Settings</h1>

    @* The account: nothing to fill in, only a code to carry — and, for those who want
       one, a username and password as well. *@
    @if (Account.Available && Account.Key is not null)
    {
        <section class="setup-block">
            <h2>Your account</h2>
            @if (Account.Code is { } accountCode)
            {
                <p class="account-code">@accountCode</p>
                <p class="muted">
                    Your name, settings and saved games, kept on the table server. Type this code
                    on another phone or computer to bring them there@(Account.Username is null ? "" : ", or sign in there as " + Account.Username).
                    Keep it to yourself, and make a new one if it gets out.
                </p>
            }
            else
            {
                <p class="muted">
                    Signed in as <strong>@Account.Username</strong>. Your name, settings and saved games
                    are kept on the table server.
                </p>
            }
            <div class="choices">
                @if (Account.Code is not null)
                {
                    <button class="choice" @onclick="CopyCode">@(_copied ? "Copied" : "Copy")</button>
                }
                @if (_confirmNew)
                {
                    <button class="choice" @onclick="NewCode">Yes — the old code stops working</button>
                    <button class="choice" @onclick="() => _confirmNew = false">Keep this one</button>
                }
                else
                {
                    <button class="choice" @onclick="() => _confirmNew = true">Make a new code</button>
                }
            </div>

            <label class="host-name">
                A code from another device
                <input placeholder="six words" @bind="_typed" @bind:event="oninput" />
            </label>
            @if (_typed.Trim().Length > 0 && Cards.Services.AccountCode.Normalize(_typed) is null)
            {
                <p class="muted">Six words, as the other device shows them.</p>
            }
            else if (Cards.Services.AccountCode.Normalize(_typed) is not null)
            {
                <p class="muted">This device's settings and saved games will be replaced by that account's.</p>
                <button class="start secondary" disabled="@_using" @onclick="UseCode">
                    @(_using ? "Fetching…" : "Use this code")
                </button>
            }
            @if (Account.UsernamesOffered)
            {
                <h2 class="subhead">Username and password</h2>
                <p class="muted">
                    Optional: a name and password to sign in with on another device, instead of the
                    code. This server has no HTTPS yet, so the password crosses your network
                    unencrypted — use one you do not use anywhere else.
                </p>
                @if (Account.Username is { } username && !_changingLogin)
                {
                    <p>You sign in as <strong>@username</strong>.</p>
                    <div class="choices">
                        <button class="choice" @onclick="() => { _changingLogin = true; _loginName = username; }">Change password</button>
                        @if (_confirmRemoveLogin)
                        {
                            <button class="choice" @onclick="RemoveLogin">Yes — remove them</button>
                            <button class="choice" @onclick="() => _confirmRemoveLogin = false">Keep them</button>
                        }
                        else
                        {
                            <button class="choice" @onclick="() => _confirmRemoveLogin = true">Remove username and password…</button>
                        }
                    </div>
                }
                else
                {
                    <label class="host-name">
                        Username
                        <input maxlength="24" autocomplete="username" @bind="_loginName" @bind:event="oninput" />
                    </label>
                    <label class="host-name">
                        Password
                        <input type="password" autocomplete="new-password" @bind="_loginPassword" @bind:event="oninput" />
                    </label>
                    <label class="host-name">
                        Password again
                        <input type="password" autocomplete="new-password" @bind="_loginAgain" @bind:event="oninput" />
                    </label>
                    <button class="start secondary"
                            disabled="@(_loginName.Trim().Length < 3 || _loginPassword.Length < 6 || _loginPassword != _loginAgain)"
                            @onclick="SaveLogin">@(Account.Username is null ? "Add username and password" : "Save new password")</button>
                    @if (_loginPassword.Length > 0 && _loginAgain.Length > 0 && _loginPassword != _loginAgain)
                    {
                        <p class="muted">The two passwords differ.</p>
                    }
                }

                <h2 class="subhead">Sign in to another account</h2>
                <label class="host-name">
                    Username
                    <input maxlength="24" autocomplete="username" @bind="_signInName" @bind:event="oninput" />
                </label>
                <label class="host-name">
                    Password
                    <input type="password" autocomplete="current-password" @bind="_signInPassword" @bind:event="oninput" />
                </label>
                @if (_signInName.Trim().Length > 0 && _signInPassword.Length > 0)
                {
                    <p class="muted">This device's settings and saved games will be replaced by that account's.</p>
                    <button class="start secondary" disabled="@_using" @onclick="SignIn">@(_using ? "Signing in…" : "Sign in")</button>
                }
            }

            @if (_accountError is not null)
            {
                <p class="error">@_accountError</p>
            }

            @if (Account.IsManager)
            {
                <p class="muted">
                    You are this server's @(Account.IsAdmin ? "admin" : "manager").
                    <a href="/admin">Manage tables@(Account.IsAdmin ? " and people" : "")</a>
                </p>
            }
            else if (Account.AdminNeeded)
            {
                <label class="host-name">
                    Setup code — the server prints it in its log until someone is admin
                    <input placeholder="four words" @bind="_setup" @bind:event="oninput" />
                </label>
                <button class="start secondary" disabled="@(_setup.Trim().Length == 0)" @onclick="ClaimAdmin">Become admin</button>
            }
        </section>
    }

    <section class="setup-block">
        <h2>Cards</h2>
        <div class="choices">
            @foreach (var (id, label) in Skins)
            {
                var captured = id;
                <button class="choice @(_skin == captured ? "chosen" : "")"
                        @onclick="() => SetSkin(captured)">@label</button>
            }
        </div>
    </section>

    <section class="setup-block">
        <h2>Pace</h2>
        <input type="range" min="0.5" max="3" step="0.1"
               value="@_pace.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="SetPace" />
        <p class="muted">@PaceLabel</p>
    </section>

    <section class="setup-block">
        <h2>Sort hands by</h2>
        <div class="choices">
            @foreach (var (mode, label) in SortChoices)
            {
                var captured = mode;
                <button class="choice @(_sort == captured ? "chosen" : "")"
                        @onclick="() => SetSort(captured)">@label</button>
            }
        </div>
        <p class="muted">
            Applies to games you have not set individually. A sort chosen at the table
            is remembered for that game and wins over this.
        </p>
    </section>

    @* The same choices the table's own Options menu offers, for a player who would
       rather set them once than per game. Both write the same settings. *@
    <section class="setup-block">
        <h2>Size</h2>
        @foreach (var (target, label) in SizeRows)
        {
            var capturedTarget = target;
            <div class="size-row">
                <span class="size-label">@label</span>
                <div class="choices">
                    @foreach (var (sizeId, sizeLabel, _) in Cards.Services.UiSizes.All)
                    {
                        var capturedSize = sizeId;
                        <button class="choice @(SizeOf(capturedTarget) == capturedSize ? "chosen" : "")"
                                title="@sizeLabel"
                                @onclick="() => SetSize(capturedTarget, capturedSize)">@ShortLabel(sizeId)</button>
                    }
                </div>
            </div>
        }
        <p class="muted">
            Extra large is how the table has always drawn; each step down is a quarter
            smaller. Set them together, or one at a time when small cards and large text
            suit you better than either alone.
        </p>
    </section>

    <section class="setup-block">
        <h2>Sound</h2>
        <label class="rule">
            <input type="checkbox" checked="@_soundOn" @onchange="SetSoundOn" />
            <span>
                <span class="rule-name">Sounds</span>
                <span class="rule-desc">
                    The shuffle and the deal, cards played and drawn, tricks gathered, points
                    scored, a bell when it is your turn, and the end of the game.
                </span>
            </span>
        </label>
        <input type="range" min="0" max="1" step="0.05" disabled="@(!_soundOn)"
               value="@_volume.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="SetVolume" />
        <p class="muted">Volume @((int)Math.Round(_volume * 100))%</p>
    </section>

    <section class="setup-block">
        <h2>Table</h2>
        <label class="rule">
            <input type="checkbox" checked="@_cardValues" @onchange="SetCardValues" />
            <span>
                <span class="rule-name">Show card points</span>
                <span class="rule-desc">
                    Write what each card is worth in the corner of its face, under the
                    game being played. The bubble that names a tapped card says the
                    value anyway in games that score their cards, so this is for seeing
                    every card at once.
                </span>
            </span>
        </label>
        <label class="rule">
            <input type="checkbox" checked="@_messages" @onchange="SetMessages" />
            <span>
                <span class="rule-name">Speech bubbles</span>
                <span class="rule-desc">
                    Show what each player is doing beside their seat. The game log keeps
                    a record either way.
                </span>
            </span>
        </label>
    </section>
</div>

@code {
    private static readonly (string Id, string Label)[] Skins =
    [
        ("simple",  "Simple"),
        ("classic", "Classic"),
    ];

    /// <summary>
    /// Null means "whatever each game prefers" — a real choice, and the default, since
    /// a definition naming its own sort usually has a reason.
    /// </summary>
    private static readonly (string? Mode, string Label)[] SortChoices =
    [
        (null,             "Game default"),
        ("suit_value",     "Suit & value"),
        ("suit_stable",    "Suit"),
        ("rank_ace_high",  "Value (ace high)"),
        ("rank",           "Value (ace low)"),
        ("none",           "Free"),
    ];

    /// <summary>"All" first, then each element on its own.</summary>
    private static readonly (string Target, string Label)[] SizeRows =
        [("all", "Everything"), .. Cards.Services.UiSizes.Targets];

    /// <summary>Five buttons on a phone need short names; the full one is the title.</summary>
    private static string ShortLabel(string sizeId) => sizeId.ToUpperInvariant();

    private string? SizeOf(string target)
        => target == "all" ? Prefs.CommonUiSize : Prefs.GetUiSize(target);

    private void SetSize(string target, string sizeId)
    {
        if (target == "all") Prefs.SetAllUiSizes(sizeId);
        else                 Prefs.SetUiSize(target, sizeId);
    }

    private void SetCardValues(ChangeEventArgs e)
    {
        _cardValues = e.Value is true;
        Prefs.ShowCardValues = _cardValues;
    }

    // ── Account ──────────────────────────────────────────────────────────────

    private string  _typed = "";
    private bool    _using, _copied, _confirmNew;
    private string? _accountError;

    private string _loginName = "", _loginPassword = "", _loginAgain = "";
    private string _signInName = "", _signInPassword = "";
    private bool   _changingLogin, _confirmRemoveLogin;

    private async Task SaveLogin()
    {
        _accountError = await Account.SetLoginAsync(_loginName.Trim(), _loginPassword);
        if (_accountError is null)
        {
            _changingLogin = false;
            _loginPassword = _loginAgain = "";
        }
    }

    private async Task RemoveLogin()
    {
        _confirmRemoveLogin = false;
        _accountError = await Account.RemoveLoginAsync() ? null : "Could not reach the server.";
    }

    /// <summary>Signs this device in to the account by name and password, then reloads as that account.</summary>
    private async Task SignIn()
    {
        _using = true;
        _accountError = await Account.SignInAsync(_signInName.Trim(), _signInPassword);
        if (_accountError is null)
        {
            Nav.NavigateTo("/settings", forceLoad: true);
            return;
        }
        _signInPassword = "";
        _using = false;
    }

    private string _setup = "";

    private async Task ClaimAdmin()
    {
        _accountError = await Account.ClaimAdminAsync(_setup)
            ? null
            : "That is not the setup code — copy it from the server's log as it appears there.";
        _setup = "";
    }

    private async Task CopyCode()
    {
        if (Account.Code is not { } code) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/export.js");
        _copied = await module.InvokeAsync<bool>("copy", code);
    }

    private async Task NewCode()
    {
        _confirmNew   = false;
        _accountError = await Account.NewCodeAsync() ? null : "Could not reach the server for a new code.";
        _copied       = false;
    }

    /// <summary>
    /// Takes this device over to the account behind the code, then reloads, so every
    /// screen reads that account's settings and saves from the start.
    /// </summary>
    private async Task UseCode()
    {
        _using = true;
        _accountError = null;
        if (await Account.UseCodeAsync(_typed))
        {
            Nav.NavigateTo("/settings", forceLoad: true);
            return;
        }
        _accountError = "No account has that code — check the words against the other device.";
        _using = false;
    }

    private bool   _soundOn = true;
    private double _volume  = 0.6;

    private void SetSoundOn(ChangeEventArgs e)
    {
        _soundOn = e.Value is true;
        Prefs.SoundOn = _soundOn;
    }

    private void SetVolume(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            _volume = v;
            Prefs.SoundVolume = v;
        }
    }

    private bool    _cardValues;
    private string  _skin     = "simple";
    private double  _pace     = 1.8;
    private string? _sort;
    private bool    _messages = true;

    protected override void OnInitialized()
    {
        _skin     = Prefs.CardSkinId;
        _pace     = Prefs.TurnPace;
        _sort     = Prefs.DefaultHandSort;
        _messages = Prefs.ShowGameMessages;
        _cardValues = Prefs.ShowCardValues;
        _soundOn    = Prefs.SoundOn;
        _volume     = Prefs.SoundVolume;
    }

    /// <summary>
    /// Described rather than numbered: "1.8x" means nothing to a player, and the useful
    /// distinction is only ever roughly how long a turn takes to watch.
    /// </summary>
    private string PaceLabel => _pace switch
    {
        < 0.9  => "Brisk — turns go by quickly",
        < 1.6  => "Steady",
        < 2.4  => "Relaxed",
        _      => "Slow — easy to follow every card",
    };

    private void SetSkin(string id)
    {
        _skin = id;
        Prefs.CardSkinId = id;
    }

    private void SetPace(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
                            System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture,
                            out var value))
        {
            _pace = value;
            Prefs.TurnPace = value;
        }
    }

    private void SetSort(string? mode)
    {
        _sort = mode;
        Prefs.DefaultHandSort = mode;
    }

    private void SetMessages(ChangeEventArgs e)
    {
        _messages = (bool)(e.Value ?? true);
        Prefs.ShowGameMessages = _messages;
    }
}

@page "/settings"
@inject Cards.Services.SettingsService Prefs
@inject NavigationManager Nav

@*
    Somewhere to change the things the app already knew how to do.

    Turn pace, hand sort and game messages were all live settings with no way to reach
    them — the pace in particular was a constant chosen in the page, with a comment
    admitting it was provisional.
*@

<PageTitle>Settings</PageTitle>

<div class="setup">
    <button class="link" @onclick="@(() => Nav.NavigateTo("/"))">&larr; Games</button>

    <h1>Settings</h1>

    <section class="setup-block">
        <h2>Cards</h2>
        <div class="choices">
            @foreach (var (id, label) in Skins)
            {
                var captured = id;
                <button class="choice @(_skin == captured ? "chosen" : "")"
                        @onclick="() => SetSkin(captured)">@label</button>
            }
        </div>
    </section>

    <section class="setup-block">
        <h2>Pace</h2>
        <input type="range" min="0.5" max="3" step="0.1"
               value="@_pace.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               @onchange="SetPace" />
        <p class="muted">@PaceLabel</p>
    </section>

    <section class="setup-block">
        <h2>Sort hands by</h2>
        <div class="choices">
            @foreach (var (mode, label) in SortChoices)
            {
                var captured = mode;
                <button class="choice @(_sort == captured ? "chosen" : "")"
                        @onclick="() => SetSort(captured)">@label</button>
            }
        </div>
        <p class="muted">
            Applies to games you have not set individually. A sort chosen at the table
            is remembered for that game and wins over this.
        </p>
    </section>

    @* The same choices the table's own Options menu offers, for a player who would
       rather set them once than per game. Both write the same settings. *@
    <section class="setup-block">
        <h2>Size</h2>
        @foreach (var (target, label) in SizeRows)
        {
            var capturedTarget = target;
            <div class="size-row">
                <span class="size-label">@label</span>
                <div class="choices">
                    @foreach (var (sizeId, sizeLabel, _) in Cards.Services.UiSizes.All)
                    {
                        var capturedSize = sizeId;
                        <button class="choice @(SizeOf(capturedTarget) == capturedSize ? "chosen" : "")"
                                title="@sizeLabel"
                                @onclick="() => SetSize(capturedTarget, capturedSize)">@ShortLabel(sizeId)</button>
                    }
                </div>
            </div>
        }
        <p class="muted">
            Extra large is how the table has always drawn; each step down is a quarter
            smaller. Set them together, or one at a time when small cards and large text
            suit you better than either alone.
        </p>
    </section>

    <section class="setup-block">
        <h2>Table</h2>
        <label class="rule">
            <input type="checkbox" checked="@_cardValues" @onchange="SetCardValues" />
            <span>
                <span class="rule-name">Show card points</span>
                <span class="rule-desc">
                    Write what each card is worth under the game being played, in the
                    corner of its face. Games that score no card values show nothing.
                </span>
            </span>
        </label>
        <label class="rule">
            <input type="checkbox" checked="@_messages" @onchange="SetMessages" />
            <span>
                <span class="rule-name">Speech bubbles</span>
                <span class="rule-desc">
                    Show what each player is doing beside their seat. The game log keeps
                    a record either way.
                </span>
            </span>
        </label>
    </section>
</div>

@code {
    private static readonly (string Id, string Label)[] Skins =
    [
        ("simple",  "Simple"),
        ("classic", "Classic"),
    ];

    /// <summary>
    /// Null means "whatever each game prefers" — a real choice, and the default, since
    /// a definition naming its own sort usually has a reason.
    /// </summary>
    private static readonly (string? Mode, string Label)[] SortChoices =
    [
        (null,             "Game default"),
        ("suit_value",     "Suit & value"),
        ("suit_stable",    "Suit"),
        ("rank_ace_high",  "Value (ace high)"),
        ("rank",           "Value (ace low)"),
        ("none",           "Free"),
    ];

    /// <summary>"All" first, then each element on its own.</summary>
    private static readonly (string Target, string Label)[] SizeRows =
        [("all", "Everything"), .. Cards.Services.UiSizes.Targets];

    /// <summary>Five buttons on a phone need short names; the full one is the title.</summary>
    private static string ShortLabel(string sizeId) => sizeId.ToUpperInvariant();

    private string? SizeOf(string target)
        => target == "all" ? Prefs.CommonUiSize : Prefs.GetUiSize(target);

    private void SetSize(string target, string sizeId)
    {
        if (target == "all") Prefs.SetAllUiSizes(sizeId);
        else                 Prefs.SetUiSize(target, sizeId);
    }

    private void SetCardValues(ChangeEventArgs e)
    {
        _cardValues = e.Value is true;
        Prefs.ShowCardValues = _cardValues;
    }

    private bool    _cardValues;
    private string  _skin     = "simple";
    private double  _pace     = 1.8;
    private string? _sort;
    private bool    _messages = true;

    protected override void OnInitialized()
    {
        _skin     = Prefs.CardSkinId;
        _pace     = Prefs.TurnPace;
        _sort     = Prefs.DefaultHandSort;
        _messages = Prefs.ShowGameMessages;
        _cardValues = Prefs.ShowCardValues;
    }

    /// <summary>
    /// Described rather than numbered: "1.8x" means nothing to a player, and the useful
    /// distinction is only ever roughly how long a turn takes to watch.
    /// </summary>
    private string PaceLabel => _pace switch
    {
        < 0.9  => "Brisk — turns go by quickly",
        < 1.6  => "Steady",
        < 2.4  => "Relaxed",
        _      => "Slow — easy to follow every card",
    };

    private void SetSkin(string id)
    {
        _skin = id;
        Prefs.CardSkinId = id;
    }

    private void SetPace(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
                            System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture,
                            out var value))
        {
            _pace = value;
            Prefs.TurnPace = value;
        }
    }

    private void SetSort(string? mode)
    {
        _sort = mode;
        Prefs.DefaultHandSort = mode;
    }

    private void SetMessages(ChangeEventArgs e)
    {
        _messages = (bool)(e.Value ?? true);
        Prefs.ShowGameMessages = _messages;
    }
}

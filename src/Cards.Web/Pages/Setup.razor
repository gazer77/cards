@page "/setup/{GameId}"
@inject GameLoader Loader
@inject NavigationManager Nav
@inject Cards.Services.GameSaveService Saves

@*
    Table setup: seat count and house rules, matching what the mobile app offers before
    a game starts. The browser client previously jumped straight from the game list to a
    table with a guessed number of seats, so half of what each game definition offers —
    every house rule, and every player count but one — was unreachable.
*@

<PageTitle>@(_game?.Name ?? "Setup")</PageTitle>

@if (_game is null)
{
    <p class="muted">@(_failed ? $"Could not load “{GameId}”." : "Loading…")</p>
}
else
{
    <div class="setup">
        <button class="link" @onclick="@(() => Nav.NavigateTo("/"))">&larr; Games</button>

        <h1>@_game.Name</h1>
        <p class="tagline">@_game.PlayerRangeText</p>

        @if (_saved.Count > 0)
        {
            <section class="setup-block">
                <h2>Resume</h2>
                @foreach (var slot in _saved)
                {
                    var captured = slot;
                    <div class="save-row">
                        <button class="save" @onclick="() => Resume(captured)">
                            <span class="save-line">@captured.PlayerCount players · @captured.Summary</span>
                            <span class="save-when">
                                @captured.SavedAt.LocalDateTime.ToString("d MMM HH:mm")
                                @if (captured.RulesText.Length > 0) { <text> · @captured.RulesText</text> }
                            </span>
                        </button>
                        <button class="save-delete" title="Delete this save"
                                @onclick="() => Delete(captured)">&times;</button>
                    </div>
                }
            </section>
        }

        <section class="setup-block">
            <h2>@(_saved.Count > 0 ? "Or start a new game" : "Players")</h2>
            <div class="stepper">
                <button class="step" disabled="@(_players <= _game.MinPlayers)"
                        @onclick="@(() => _players--)">&minus;</button>
                <span class="step-value">@_players</span>
                <button class="step" disabled="@(_players >= _game.MaxPlayers)"
                        @onclick="@(() => _players++)">+</button>
            </div>
            <p class="muted">You take the first seat; the rest are AI.</p>
        </section>

        @if (_rules.Count > 0)
        {
            <section class="setup-block">
                <h2>House rules</h2>
                @foreach (var rule in _rules)
                {
                    var captured = rule;
                    <label class="rule">
                        <input type="checkbox"
                               checked="@captured.IsEnabled"
                               @onchange="e => captured.IsEnabled = (bool)(e.Value ?? false)" />
                        <span>
                            <span class="rule-name">@captured.Name</span>
                            @if (!string.IsNullOrWhiteSpace(captured.Description))
                            {
                                <span class="rule-desc">@captured.Description</span>
                            }
                        </span>
                    </label>
                }
            </section>
        }

        <button class="start" @onclick="Start">Start game</button>
    </div>
}

@code {
    [Parameter] public string GameId { get; set; } = string.Empty;

    private Cards.Models.GameDefinition? _game;
    private List<Cards.Models.HouseRule> _rules = [];
    private int  _players;
    private bool _failed;

    private List<Cards.Engine.SaveSlot> _saved = [];

    protected override async Task OnInitializedAsync()
    {
        _game = await Loader.LoadAsync(GameId);
        if (_game is null) { _failed = true; return; }

        await Saves.EnsureLoadedAsync();
        _saved = Saves.SavesFor(GameId).ToList();

        _players = _game.MinPlayers;
        _rules   = _game.HouseRules;

        // A rule marked default-on in the definition starts checked, as on mobile.
        foreach (var rule in _rules)
            rule.IsEnabled = rule.Default;
    }

    /// <summary>
    /// Resumes a save. Its seat count and rules come from the save itself, so nothing
    /// chosen on this page is carried across — the position defines its own table.
    /// </summary>
    private void Resume(Cards.Engine.SaveSlot slot)
        => Nav.NavigateTo($"/play/{GameId}/{slot.PlayerCount}?slot={slot.Id}");

    private async Task Delete(Cards.Engine.SaveSlot slot)
    {
        await Saves.DeleteAsync(slot.Id);
        _saved = Saves.SavesFor(GameId).ToList();
    }

    private void Start()
    {
        var enabled = _rules.Where(r => r.IsEnabled).Select(r => r.Id).ToList();
        string query = enabled.Count > 0
            ? "?rules=" + Uri.EscapeDataString(string.Join(",", enabled))
            : string.Empty;

        Nav.NavigateTo($"/play/{GameId}/{_players}{query}");
    }
}

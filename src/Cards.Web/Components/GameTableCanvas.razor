@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using Cards.Engine
@using Cards.Rendering
@using Cards.Web.Platform
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS
@implements IDisposable

@* --rs scales the canvas element down and CSS scales it back up; see RenderScale. *@
<div class="table-canvas"
     style="--rs: @_renderScale.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     @onpointerdown="HandlePointerDown"
     @onpointermove="HandlePointerMove"
     @onpointerup="HandlePointerUp"
     @onpointercancel="HandlePointerCancel">
    <SKCanvasView @ref="_view" OnPaintSurface="OnPaint" />
</div>

@code {
    private SKCanvasView? _view;
    private CardTableRenderer? _renderer;
    private BrowserAnimationDriver? _driver;

    /// <summary>
    /// Most canvas pixels we will render per CSS pixel, regardless of how dense the
    /// display is.
    ///
    /// Skia under WebAssembly rasterises on the CPU, so cost scales with pixel count —
    /// and a phone has more pixels than a desktop while having far less CPU to spend on
    /// them. A 390x844 phone at devicePixelRatio 3 is 2.96 million pixels, twice a
    /// 1920x766 desktop table. Rendering that honestly is what makes the browser client
    /// unusable on the devices most likely to run it.
    ///
    /// Capping costs sharpness, but cards are large flat high-contrast shapes rather
    /// than fine text, so the loss is slight while the saving is quadratic: capping a
    /// DPR-3 phone at 1.5 renders a quarter of the pixels.
    /// </summary>
    private const double MaxPixelRatio = 1.5;

    // Canvas pixels per CSS pixel, after the cap. Pointer events report CSS pixels
    // while the canvas backing store is in device pixels, so every point must be
    // scaled by this. Getting it wrong puts every tap 2-3x off on a phone or Retina
    // display — invisible on a 1x desktop monitor, which is what makes it easy to ship.
    private double _pixelRatio = 1.0;

    // How far the canvas element is shrunk before CSS scales it back up to fill the
    // table. 1.0 means no capping was needed.
    private double _renderScale = 1.0;

    // ShouldRender is off, so a render has to be asked for explicitly.
    private bool _needsRender;

    /// <summary>
    /// The renderer behind this canvas, so the page can hand it to the turn loop as an
    /// animator. Null until the component has initialised.
    /// </summary>
    public CardTableRenderer? Renderer => _renderer;

    [Parameter] public EventCallback<string> CardTapped { get; set; }
    [Parameter] public EventCallback<string> ZoneTapped { get; set; }
    [Parameter] public EventCallback TableTapped { get; set; }
    [Parameter] public EventCallback<(string CardId, string ZoneId)> CardDropped { get; set; }
    [Parameter] public EventCallback<(string CardId, int NewIndex)> CardReordered { get; set; }

    /// <summary>
    /// Never re-renders from Blazor's side. The markup is a single fixed element and
    /// every visual change goes through <see cref="Sync"/> and <see cref="Redraw"/>.
    ///
    /// Without this the parent's StateHasChanged re-renders this component on every
    /// turn — the event-callback parameters are new delegates each time, so the
    /// equality check never short-circuits — and re-rendering the canvas host makes
    /// the whole table flash.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (!_needsRender) return false;

        _needsRender = false;
        return true;
    }

    protected override void OnInitialized()
    {
        _driver   = new BrowserAnimationDriver();
        _renderer = new CardTableRenderer(_driver);

        _renderer.RedrawRequested      += Redraw;
        _renderer.CardTapped           += id     => _ = CardTapped.InvokeAsync(id);
        _renderer.ZoneTapped           += id     => _ = ZoneTapped.InvokeAsync(id);
        _renderer.CanvasTapped         += ()     => _ = TableTapped.InvokeAsync();
        _renderer.CardDropped          += (c, z) => _ = CardDropped.InvokeAsync((c, z));
        _renderer.CardReorderedInHand  += (c, i) => _ = CardReordered.InvokeAsync((c, i));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        double dpr;
        try
        {
            dpr = await JS.InvokeAsync<double>("eval", "window.devicePixelRatio || 1");
        }
        catch
        {
            dpr = 1.0;   // fall back to 1:1 rather than failing to start
        }

        // SKCanvasView sizes its backing store as (element CSS size x devicePixelRatio),
        // with no way to ask for a fraction of that. So the element is laid out smaller
        // and CSS scales it back up to fill the table: the backing store lands on the
        // capped ratio while the table still occupies the same space on screen.
        var scaling = DisplayScaling.For(dpr, MaxPixelRatio);
        _pixelRatio  = scaling.PixelRatio;
        _renderScale = scaling.RenderScale;

        if (_renderScale < 1.0)
        {
            _needsRender = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pushes the current table state into the renderer and repaints.
    ///
    /// Deliberately a method rather than [Parameter]s: the view model mutates one
    /// GameState instance in place, so Blazor's reference-equality parameter check
    /// decides nothing has changed and never re-renders this component. The symptom is
    /// a table that paints its felt once and then never draws a card.
    /// </summary>
    public void Sync(
        GameState? state,
        IReadOnlyList<string> selectableCardIds,
        string? selectedCardId,
        IReadOnlyList<string> dropZoneIds)
    {
        if (_renderer is null) return;

        _renderer.GameState         = state;
        _renderer.SelectableCardIds = selectableCardIds;
        _renderer.SelectedCardId    = selectedCardId;
        _renderer.DropZoneIds       = dropZoneIds;

        Redraw();
    }

    private void OnPaint(SKPaintSurfaceEventArgs e)
        => _renderer?.Paint(e.Surface.Canvas, e.Info);

    // Offsets are relative to the wrapper, which keeps its full CSS size, so the
    // element's own shrink-and-scale-up is invisible here.
    private SKPoint ToCanvas(PointerEventArgs e)
        => new((float)(e.OffsetX * _pixelRatio), (float)(e.OffsetY * _pixelRatio));

    private void HandlePointerDown(PointerEventArgs e)   => _renderer?.OnPointerDown(ToCanvas(e));
    private void HandlePointerMove(PointerEventArgs e)   => _renderer?.OnPointerMove(ToCanvas(e));
    private void HandlePointerUp(PointerEventArgs e)     => _renderer?.OnPointerUp(ToCanvas(e));
    private void HandlePointerCancel(PointerEventArgs e) => _renderer?.OnPointerCancel();

    public void Redraw() => _ = InvokeAsync(() => _view?.Invalidate());

    public void Dispose()
    {
        if (_renderer is not null) _renderer.RedrawRequested -= Redraw;
        _driver?.Dispose();
    }
}

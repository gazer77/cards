<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ThisPage"
    x:Class="Cards.Pages.GameTablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Cards.Views"
    Shell.NavBarIsVisible="False"
    BackgroundColor="Black">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Thin title strip -->
        <Border
            Grid.Row="0"
            BackgroundColor="{StaticResource HudBackground}"
            StrokeThickness="0"
            Padding="0,4">
            <Label
                Text="{Binding Title, Source={x:Reference ThisPage}}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="White" />
        </Border>

        <!-- SkiaSharp game canvas (touch handled natively via EnableTouchEvents) -->
        <views:GameTableView
            x:Name="TableCanvas"
            Grid.Row="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- Stacking message overlay (just above player hand) -->
        <VerticalStackLayout
            x:Name="StatusMessagesPanel"
            Grid.Row="1"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Spacing="6"
            MaximumWidthRequest="300"
            InputTransparent="True" />

        <!-- Bottom action bar -->
        <Border
            Grid.Row="2"
            BackgroundColor="{StaticResource HudBackground}"
            StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" Padding="12,12">
                <HorizontalStackLayout
                    x:Name="ActionButtonsPanel"
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="12" />
                <Button
                    x:Name="GearButton"
                    Grid.Column="1"
                    Text="⚙"
                    FontSize="18"
                    Style="{StaticResource HudButton}"
                    Clicked="OnGearClicked" />
            </Grid>
        </Border>

        <!-- Gear menu backdrop — tap to dismiss -->
        <BoxView
            x:Name="GearMenuBackdrop"
            Grid.Row="1"
            Color="Transparent"
            IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGearMenuDismissed" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Gear menu panel -->
        <Border
            x:Name="GearMenuPanel"
            Grid.Row="1"
            IsVisible="False"
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,8,4"
            BackgroundColor="#1A162B1F"
            StrokeShape="RoundRectangle 12"
            Stroke="{StaticResource Gold}"
            StrokeThickness="1"
            Padding="6">
            <VerticalStackLayout Spacing="4" MinimumWidthRequest="170">
                <Button
                    x:Name="GearSortButton"
                    Text="Sort Hand…"
                    Style="{StaticResource HudButton}"
                    IsVisible="False"
                    HorizontalOptions="Fill"
                    Clicked="OnGearSortClicked" />
                <Button
                    x:Name="GearLogButton"
                    Text="Game Log"
                    Style="{StaticResource HudButton}"
                    IsVisible="False"
                    HorizontalOptions="Fill"
                    Clicked="OnGearLogClicked" />
                <Button
                    Text="Rules"
                    Style="{StaticResource HudButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnGearRulesClicked" />
                <Button
                    Text="New Game"
                    Style="{StaticResource HudButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnGearNewGameClicked" />
                <Button
                    Text="Leave Game"
                    Style="{StaticResource HudButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnGearLeaveClicked" />
            </VerticalStackLayout>
        </Border>

        <!-- Game-over overlay — covers entire screen including bottom bar -->
        <Grid
            x:Name="GameOverOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            BackgroundColor="#D9000000"
            IsVisible="False">
            <Border
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="40,36"
                BackgroundColor="{StaticResource SurfaceDark}"
                StrokeShape="RoundRectangle 16"
                Stroke="{StaticResource Gold}"
                StrokeThickness="1.5">
                <VerticalStackLayout Spacing="20" MinimumWidthRequest="260">

                    <Label
                        x:Name="GameOverResultLabel"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource Gold}"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        x:Name="GameOverSubLabel"
                        HorizontalTextAlignment="Center"
                        TextColor="{StaticResource TextSecondary}"
                        FontSize="14"
                        IsVisible="False" />

                    <Button
                        Text="Play Again"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0"
                        Clicked="OnPlayAgainClicked" />

                    <Button
                        Text="Main Menu"
                        Style="{StaticResource HudButton}"
                        HorizontalOptions="Center"
                        Clicked="OnMenuClicked" />

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Game log overlay -->
        <Grid
            x:Name="GameLogOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            BackgroundColor="#D9000000"
            IsVisible="False">
            <!-- Tap backdrop to dismiss -->
            <BoxView Color="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogOverlayDismissed" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Margin="20,60,20,20"
                BackgroundColor="{StaticResource SurfaceDark}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Grid RowDefinitions="Auto,*,Auto" Padding="0">

                    <!-- Header -->
                    <Border
                        Grid.Row="0"
                        BackgroundColor="{StaticResource SurfaceMid}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16,16,0,0"
                        Padding="20,16">
                        <Label
                            Text="GAME LOG"
                            Style="{StaticResource FieldLabel}"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Log entries -->
                    <CollectionView
                        x:Name="GameLogList"
                        Grid.Row="1"
                        Margin="0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" Padding="16,8" ColumnSpacing="12">
                                    <BoxView
                                        Grid.Column="0"
                                        Color="{StaticResource Gold}"
                                        WidthRequest="3"
                                        HeightRequest="14"
                                        VerticalOptions="Center"
                                        CornerRadius="2" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding .}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="13"
                                        LineBreakMode="WordWrap" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="8" Color="Transparent" />
                        </CollectionView.Footer>
                    </CollectionView>

                    <!-- Close button -->
                    <Border
                        Grid.Row="2"
                        BackgroundColor="{StaticResource SurfaceMid}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0,0,16,16"
                        Padding="20,12">
                        <Button
                            Text="Close"
                            Style="{StaticResource HudButton}"
                            HorizontalOptions="Center"
                            Clicked="OnLogOverlayDismissed" />
                    </Border>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>

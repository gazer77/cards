{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Tables": {
    // Serve the web app from here too. Set false to run as an API only, with the web
    // app hosted somewhere else.
    "ServeWebClient": true,

    // Where the web app is served from, when that is not here: every origin a browser
    // may call the hub from. Empty when the web app is served by this server.
    "AllowedOrigins": [],

    // The folder rooms are kept in, so a restart does not end every game. Relative to
    // the server's folder. Empty: under systemd with StateDirectory= set, that folder;
    // otherwise rooms last only as long as the server runs.
    "RoomDirectory": ""
  }
}

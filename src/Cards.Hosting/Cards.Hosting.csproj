<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hosting shared tables: rooms, seats, votes, and the one copy of each game. Plain
       .NET with no web framework in it, so the same code runs in the table server and,
       when a phone hosts a game, inside the app. How messages reach people is the
       host's business (ITableClients): SignalR on the server, whatever the phone uses. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cards.Hosting</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cards.Core\Cards.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
